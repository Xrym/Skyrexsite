# Настройки AI-Ассистента Skyrex
# Провайдеры: gemini, openrouter, groq, ollama
LLM_PROVIDER=gemini

# Ваш API-ключ (для ollama оставьте пустым)
# Бесплатные ключи: aistudio.google.com или openrouter.ai
LLM_API_KEY=your_api_key_here

# Модель для общения:
# - Для gemini: gemini-2.5-flash
# - Для openrouter: meta-llama/llama-3.3-70b-instruct:free
# - Для groq: llama-3.3-70b-versatile
LLM_MODEL=gemini-2.5-flash

# Сетевые настройки сервера
HOST=0.0.0.0
PORT=5000

# Фоновый планировщик обновления цен (Ситилинк / ДНС)
ENABLE_AUTO_SCRAPER=false
SCRAPER_INTERVAL_HOURS=12

# Прокси для парсинга (опционально)
# CITILINK_PROXY=http://username:password@proxy-host:port
