# ==============================================================================
# Skyrex Computers - Server Configuration Template (.env.example)
# ==============================================================================

# 1. Сетевые настройки веб-сервера
HOST=0.0.0.0
PORT=5000
DEBUG=false

# 2. Настройки AI-Ассистента
# Доступные провайдеры: gemini, openrouter, groq, ollama
LLM_PROVIDER=gemini

# Ваш API-ключ (для ollama оставьте пустым)
# Бесплатные ключи: aistudio.google.com или openrouter.ai
LLM_API_KEY=your_api_key_here

# Модель для общения:
# - Для gemini: gemini-2.5-flash
# - Для openrouter: meta-llama/llama-3.3-70b-instruct:free
# - Для groq: llama-3.3-70b-versatile
# - Для ollama: qwen2.5:7b или llama3.1
LLM_MODEL=gemini-2.5-flash

# Опциональный прокси для обхода гео-блокировок API LLM (например: http://127.0.0.1:10809)
# LLM_PROXY=

# 3. Telegram-бот администрирования (заполните секретами только в локальном/серверном .env)
TG_BOT_TOKEN=
TG_ADMIN_IDS=
# Формат: один или несколько числовых Telegram ID через запятую.

# 4. Учётная запись администратора сайта (опционально)
# Если указаны, аккаунт администратора создаётся/обновляется автоматически при запуске
# ADMIN_LOGIN=admin
# ADMIN_PASSWORD=your_secure_password_here

# 5. Фоновый планировщик обновления каталога цен ОнлайнТрейд (опционально)
ENABLE_AUTO_SCRAPER=false
SCRAPER_INTERVAL_HOURS=24

# 6. SSH deployment (optional; prefer SSH keys over a password)
DEPLOY_HOST=your_server_host
DEPLOY_USER=your_server_user
DEPLOY_REMOTE_DIR=/var/www/skyrex
# DEPLOY_SSH_PASSWORD=
